{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tunza-api.onrender.com/api",
        "EXPO_PUBLIC_MAPS_ENABLED": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tunza-api.onrender.com/api",
        "EXPO_PUBLIC_MAPS_ENABLED": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
